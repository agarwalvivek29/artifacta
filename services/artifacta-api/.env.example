# Environment variables for artifacta-api
# Copy this file to .env and fill in real values.
# NEVER commit .env — it is gitignored.
# Keep this file up to date with placeholder (non-functional) values.

# ─── Application ─────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# MongoDB
# MONGO_URI=mongodb://user:password@localhost:27017/dbname

# ─── Cache / Queue ───────────────────────────────────────────────────────────
# Redis
# REDIS_URL=redis://localhost:6379

# Kafka
# KAFKA_BROKERS=localhost:9092
# KAFKA_GROUP_ID=artifacta-api-group

# RabbitMQ
# RABBITMQ_URL=amqp://user:password@localhost:5672

# ─── Auth (REQUIRED — all services) ──────────────────────────────────────────
# Shared JWT secret used to sign and verify tokens across all services.
# Minimum 32 characters. Generate with: openssl rand -hex 32
JWT_SECRET=replace-me-with-32-char-minimum-random-string

# JWT expiry in seconds (default: 1 hour)
JWT_EXPIRY_SECONDS=3600

# Shared API key for service-to-service (BE↔BE) communication.
# Set the same value in all services. Generate with: openssl rand -hex 32
API_KEY=replace-me-with-a-secure-random-api-key

# ─── External services ─────��─────────────────────────────────────────────────
# Add API keys and external service URLs here
# SOME_API_KEY=replace-me

# ─── AWS (if needed) ─────────────────────────────────────────────────────────
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=replace-me
# AWS_SECRET_ACCESS_KEY=replace-me

# ─── ArtifactA config overrides (ARTIFACTA_ prefix) ──────────────────────────
# These override values from the config file / built-in defaults when set.
# HTTP listen address for the API server
# ARTIFACTA_ADDR=:8080
# Public base URL used to build absolute links
# ARTIFACTA_BASE_URL=http://localhost:8080
# Directory where published artifacts and data are stored
# ARTIFACTA_DATA_DIR=/var/lib/artifacta/data
# ─── OIDC browser SSO (ADR-0007, FR6) ────────────────────────────────────────
# Set OIDC_ISSUER and OIDC_CLIENT_ID to enable Authorization-Code + PKCE browser
# login (/login → IdP → /callback). When unset, the Local single-token adapter
# is used instead.
# OIDC issuer URL (must serve /.well-known/openid-configuration)
# ARTIFACTA_OIDC_ISSUER=https://issuer.example.com
# OIDC client ID for this application
# ARTIFACTA_OIDC_CLIENT_ID=replace-me
# OIDC client secret (confidential web client)
# ARTIFACTA_OIDC_CLIENT_SECRET=replace-me
# OIDC redirect/callback URL — must match the IdP client config and this host
# ARTIFACTA_OIDC_REDIRECT_URL=http://localhost:8080/callback
# Session secret — keys the HMAC signature on stateless session cookies.
# REQUIRED when OIDC is enabled. Generate with: openssl rand -hex 32
# ARTIFACTA_SESSION_SECRET=replace-me-with-32-char-minimum-random-string
