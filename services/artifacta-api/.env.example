# Environment variables for artifacta-api
# Copy this file to .env and fill in real values.
# NEVER commit .env — it is gitignored.
# Keep this file up to date with placeholder (non-functional) values.

# ─── Application ─────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# MongoDB
# MONGO_URI=mongodb://user:password@localhost:27017/dbname

# ─── Cache / Queue ───────────────────────────────────────────────────────────
# Redis
# REDIS_URL=redis://localhost:6379

# Kafka
# KAFKA_BROKERS=localhost:9092
# KAFKA_GROUP_ID=artifacta-api-group

# RabbitMQ
# RABBITMQ_URL=amqp://user:password@localhost:5672

# ─── Auth (REQUIRED — all services) ──────────────────────────────────────────
# Shared JWT secret used to sign and verify tokens across all services.
# Minimum 32 characters. Generate with: openssl rand -hex 32
JWT_SECRET=replace-me-with-32-char-minimum-random-string

# JWT expiry in seconds (default: 1 hour)
JWT_EXPIRY_SECONDS=3600

# Shared API key for service-to-service (BE↔BE) communication.
# Set the same value in all services. Generate with: openssl rand -hex 32
API_KEY=replace-me-with-a-secure-random-api-key

# ─── External services ─────��─────────────────────────────────────────────────
# Add API keys and external service URLs here
# SOME_API_KEY=replace-me

# ─── AWS (if needed) ─────────────────────────────────────────────────────────
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=replace-me
# AWS_SECRET_ACCESS_KEY=replace-me

# ─── ArtifactA config overrides (ARTIFACTA_ prefix) ──────────────────────────
# These override values from the config file / built-in defaults when set.
# HTTP listen address for the API server
# ARTIFACTA_ADDR=:8080
# Public base URL used to build absolute links
# ARTIFACTA_BASE_URL=http://localhost:8080
# Directory where published artifacts and data are stored
# ARTIFACTA_DATA_DIR=/var/lib/artifacta/data
# Root domain for subdomain artifact hosting (ADR-0017). When set, artifacts are
# reachable at {slug|label}.{ROOT_DOMAIN}. Requires wildcard DNS + TLS + a proxy
# forwarding Host (Phase 2 infra). Leave empty to disable subdomain routing.
# ARTIFACTA_ROOT_DOMAIN=artifacta.genorim.xyz
# Org branding for the dashboard/viewer navbar (cosmetic). OrgName is the wordmark;
# LogoURL is an image shown beside it. Both empty falls back to the ArtifactA mark.
# ARTIFACTA_ORG_NAME=Acme
# ARTIFACTA_LOGO_URL=https://acme.example.com/logo.svg
# Metadata store backend (ADR-0009): "file" (default; JSON on disk, single-instance)
# or "postgres" (GORM; horizontally scalable, schema auto-migrates on startup).
# ARTIFACTA_STORE=file
# Postgres DSN — required when ARTIFACTA_STORE=postgres.
# ARTIFACTA_DATABASE_URL=postgres://user:pass@host:5432/artifacta?sslmode=require
# ─── Blob store (ADR-0006) ───────────────────────────────────────────────────
# Artifact BYTES backend: "file" (default; bundles on local disk under DATA_DIR)
# or "s3" (any S3-compatible backend — AWS S3, MinIO, Cloudflare R2, Backblaze B2,
# Wasabi). S3 is used strictly server-side: the app streams bytes through itself
# after per-view authorization; it NEVER issues presigned URLs to the browser, so
# every byte stays gated by CanView and logged to the audit trail. Keep the bucket
# private (Block Public Access on) — the server's credentials are the only access.
# ARTIFACTA_BLOB=s3
# S3 endpoint URL — leave unset for AWS S3; set to the service URL for MinIO/R2/etc.
# ARTIFACTA_S3_ENDPOINT=http://localhost:9000
# Region — required by the signer; MinIO/R2 ignore the value (default us-east-1).
# ARTIFACTA_S3_REGION=us-east-1
# Bucket that holds the artifact bundles — REQUIRED when ARTIFACTA_BLOB=s3.
# ARTIFACTA_S3_BUCKET=artifacta-bundles
# Credentials for the server's own IAM identity (never handed to clients).
# ARTIFACTA_S3_ACCESS_KEY_ID=replace-me
# ARTIFACTA_S3_SECRET_ACCESS_KEY=replace-me
# Path-style addressing — set true for MinIO and R2 (which don't do vhost-style).
# ARTIFACTA_S3_FORCE_PATH_STYLE=true
# ─── OIDC browser SSO (ADR-0007, FR6) ────────────────────────────────────────
# Set OIDC_ISSUER and OIDC_CLIENT_ID to enable Authorization-Code + PKCE browser
# login (/login → IdP → /callback). When unset, the Local single-token adapter
# is used instead.
# OIDC issuer URL (must serve /.well-known/openid-configuration)
# ARTIFACTA_OIDC_ISSUER=https://issuer.example.com
# OIDC client ID for this application
# ARTIFACTA_OIDC_CLIENT_ID=replace-me
# OIDC client secret (confidential web client)
# ARTIFACTA_OIDC_CLIENT_SECRET=replace-me
# OIDC redirect/callback URL — must match the IdP client config and this host
# ARTIFACTA_OIDC_REDIRECT_URL=http://localhost:8080/callback
# Session secret — keys the HMAC signature on stateless session cookies.
# REQUIRED when OIDC is enabled. Generate with: openssl rand -hex 32
# ARTIFACTA_SESSION_SECRET=replace-me-with-32-char-minimum-random-string
# ─── CLI login (ADR-0020) ────────────────────────────────────────────────────
# `artifacta login <url>` self-configures from GET /.well-known/artifacta-cli — the
# server advertises this issuer + client_id, so CLI users need no OIDC env vars. For
# that flow the IdP client must permit the loopback redirect (http://127.0.0.1:<port>/
# callback), public/PKCE with an empty secret, offline_access (refresh tokens), and
# must return an id_token on the refresh grant. The CLI stores its own tokens under
# $ARTIFACTA_HOME; ARTIFACTA_ACCESS_TOKEN / ARTIFACTA_REFRESH_TOKEN can override them.
